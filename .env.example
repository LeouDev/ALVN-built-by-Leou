# Inquiry form email (server-side only; never prefix these with NEXT_PUBLIC_)
# EMAIL_PROVIDER: "resend", or "console" to print emails to the terminal during local development
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Where inquiries are delivered, e.g. you@example.com
INQUIRY_EMAIL=
# A sender on a domain verified in Resend, e.g. ALVN <inquiries@yourdomain.com>
EMAIL_FROM=

# Optional: canonical URL used in metadata and the sitemap (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
