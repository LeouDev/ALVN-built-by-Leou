# Inquiry form email (server-side only; never prefix these with NEXT_PUBLIC_)
# EMAIL_PROVIDER: "brevo", or "console" to print emails to the terminal during local development
EMAIL_PROVIDER=brevo
# Brevo → SMTP & API → API Keys (a v3 API key, starts with xkeysib-)
BREVO_API_KEY=
# Where inquiries are delivered, e.g. you@example.com
INQUIRY_EMAIL=
# A sender verified in Brevo (Senders, Domains & Dedicated IPs), e.g. ALVN <hello@yourdomain.com>
EMAIL_FROM=

# Optional: canonical URL used in metadata and the sitemap (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
