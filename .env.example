# Inquiry form email (server-side only; never prefix these with NEXT_PUBLIC_)
# EMAIL_PROVIDER: "brevo", or "console" to print emails to the terminal during local development
EMAIL_PROVIDER=brevo
# Brevo → SMTP & API → API Keys (a v3 API key, starts with xkeysib-)
BREVO_API_KEY=
# Where inquiries are delivered, e.g. you@example.com
INQUIRY_EMAIL=
# A sender verified in Brevo (Senders, Domains & Dedicated IPs), e.g. ALVN <hello@yourdomain.com>
EMAIL_FROM=

# Optional: canonical URL used in metadata and the sitemap (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=

# Call booking: the Apps Script web app URL (ends in /exec) and a long random secret it shares with the site.
# See apps-script/Code.gs. Leave BOOKING_URL empty to hide the "Book a call" option on /contact.
BOOKING_URL=
BOOKING_SECRET=

# Admin (/admin). DATABASE_URL is Supabase's "Transaction pooler" connection string (port 6543); run
# `node --env-file=.env.local scripts/db-setup.mjs` once to create the tables. Sign-in links go to ADMIN_EMAIL.
# ADMIN_SECRET signs the session cookie: 32+ random characters (e.g. `openssl rand -hex 32`).
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_SECRET=
